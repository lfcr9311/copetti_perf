# Caddy da porta 80/443 (servico "caddy" do docker-compose.yml).
# PERF_DOMAIN vazio = so http na porta 80; com dominio, HTTPS automatico.
{$PERF_DOMAIN} {
	# mapa / planejador FMS (repositorio mega_map, ~/mega_map no EC2). O container
	# fmsnav entra na rede deste compose e ja responde em /map, sem tirar o prefixo.
	# So /map e /map/...: /mapa, /maps etc. continuam no motor
	@mapa path /map /map/*
	handle @mapa {
		reverse_proxy fmsnav:8001
	}

	# importador RPL (repositorios rpl-s3-uploader-frontend e -backend no EC2). O
	# Caddy do rpl-frontend serve a tela em /rpl/ e repassa /rpl/api para o backend
	@rpl path /rpl /rpl/*
	handle @rpl {
		reverse_proxy rpl-frontend:80
	}

	# previsao Tomorrow.io (repositorio notam_tw, ~/notam_tw no EC2). Tira o prefixo:
	# o app serve em / e o frontend usa caminhos relativos, por isso /weather -> /weather/
	redir /weather /weather/
	handle_path /weather/* {
		reverse_proxy notam-tw:8000
	}

	# todo o resto: motor de calculo
	reverse_proxy perf:8765
}
